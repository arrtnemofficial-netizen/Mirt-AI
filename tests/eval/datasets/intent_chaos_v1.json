{
  "version": "1.0.0",
  "project": "MIRT-intent-chaos",
  "description": "UA/RU суржик, помилки, multi-intent, короткі репліки, емодзі для перевірки маршрутизації.",
  "tests": [
    {
      "id": "CHAOS-001",
      "text": "прив, шо є на дєвачку 128?",
      "expected_intent": "DISCOVERY_OR_QUESTION",
      "expected_route": "discovery",
      "detected_intent": "DISCOVERY_OR_QUESTION",
      "resolved_route": "discovery",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-002",
      "text": "оплата куда кидать? карта/наложка",
      "expected_intent": "PAYMENT_DELIVERY",
      "expected_route": "payment",
      "detected_intent": "PAYMENT_DELIVERY",
      "resolved_route": "payment",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": true,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-003",
      "text": "где мой заказ?? 2 неділі нема 😡",
      "expected_intent": "COMPLAINT",
      "expected_route": "escalation",
      "detected_intent": "COMPLAINT",
      "resolved_route": "escalation",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": true,
      "escalated": true
    },
    {
      "id": "CHAOS-004",
      "text": "є синє? і скіки грн",
      "expected_intent": "MULTI_INTENT",
      "expected_route": "discovery",
      "detected_intent": "DISCOVERY_OR_QUESTION",
      "resolved_route": "discovery",
      "expected_ambiguous": true,
      "is_ambiguous": true,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-005",
      "text": "хачу купить но незнаю размер помогите",
      "expected_intent": "SIZE_HELP",
      "expected_route": "size_help",
      "detected_intent": "SIZE_HELP",
      "resolved_route": "size_help",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-006",
      "text": "???",
      "expected_intent": "UNKNOWN_OR_EMPTY",
      "expected_route": "clarify",
      "detected_intent": "UNKNOWN_OR_EMPTY",
      "resolved_route": "clarify",
      "expected_ambiguous": true,
      "is_ambiguous": true,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-007",
      "text": "оплачу завтра, а де реквізити?",
      "expected_intent": "PAYMENT_DELIVERY",
      "expected_route": "payment",
      "detected_intent": "PAYMENT_DELIVERY",
      "resolved_route": "payment",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": true,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-008",
      "text": "алло менеджера сюди, вже третій раз пишу",
      "expected_intent": "COMPLAINT",
      "expected_route": "escalation",
      "detected_intent": "COMPLAINT",
      "resolved_route": "escalation",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": true,
      "escalated": true
    },
    {
      "id": "CHAOS-009",
      "text": "дякс ❤️",
      "expected_intent": "THANKYOU_SMALLTALK",
      "expected_route": "end",
      "detected_intent": "THANKYOU_SMALLTALK",
      "resolved_route": "end",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-010",
      "text": "фото кинула, є таке? 👀",
      "expected_intent": "PHOTO_IDENT",
      "expected_route": "vision",
      "detected_intent": "PHOTO_IDENT",
      "resolved_route": "vision",
      "expected_ambiguous": false,
      "is_ambiguous": false,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    },
    {
      "id": "CHAOS-011",
      "text": "та ну, і дорого і доставка довга",
      "expected_intent": "COMPLAINT",
      "expected_route": "escalation",
      "detected_intent": "COMPLAINT",
      "resolved_route": "escalation",
      "expected_ambiguous": true,
      "is_ambiguous": true,
      "requires_payment_route": false,
      "requires_escalation": true,
      "escalated": true
    },
    {
      "id": "CHAOS-012",
      "text": "ок",
      "expected_intent": "UNKNOWN_OR_EMPTY",
      "expected_route": "clarify",
      "detected_intent": "UNKNOWN_OR_EMPTY",
      "resolved_route": "clarify",
      "expected_ambiguous": true,
      "is_ambiguous": true,
      "requires_payment_route": false,
      "requires_escalation": false,
      "escalated": false
    }
  ]
}